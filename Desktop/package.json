{
  "name": "henu-erp",
  "version": "2.0.0",
  "description": "HENU ERP - Society Accounting & Management System",
  "main": "src/main/main.js",
  "author": {
    "name": "HENU OS PRIVATE LIMITED",
    "url": "http://www.henuos.in"
  },
  "homepage": "http://www.henuos.in",
  "scripts": {
    "start": "electron src/main/main.js",
    "dev": "electron src/main/main.js --dev",
    "test": "electron scripts/verify-electron.js",
    "test:e2e": "node scripts/test-e2e-scenarios.js",
    "dist": "electron-builder --win"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "in.henuos.erp",
    "productName": "HENU ERP",
    "copyright": "Copyright © 2026 HENU OS PRIVATE LIMITED",
    "directories": {
      "output": "D:\\jeevika_erp_v2\\Relese2026"
    },
    "files": [
      "src/**/*",
      "icon.ico",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/webapp",
        "to": "webapp"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HENU ERP",
      "artifactName": "20261118_henuerp_setup_v02.exe",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "runAfterFinish": true
    }
  }
}
